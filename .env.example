# NestJS/Lambda runtime connection. Copy the Transaction pooler values from
# Supabase Dashboard > Connect; do not construct the pooler host yourself.
POSTGRES_HOST=aws-0-ap-southeast-2.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_SSL_MODE=require
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_QUERY_TIMEOUT_MS=10000
POSTGRES_IDLE_TIMEOUT_MS=10000

# Optional stronger certificate verification. Download the certificate from
# Supabase Database Settings, set mode to verify-full, and store the PEM with
# newlines escaped as \n in the deployment secret/environment variable.
# POSTGRES_SSL_MODE=verify-full
# POSTGRES_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Supabase role bootstrap — use the shared Session pooler values from Connect.
# These admin credentials are used only by db:bootstrap:supabase and must never
# be deployed to Lambda.
POSTGRES_BOOTSTRAP_HOST=aws-0-ap-southeast-2.pooler.supabase.com
POSTGRES_BOOTSTRAP_PORT=5432
POSTGRES_BOOTSTRAP_USER=postgres.your-project-ref
POSTGRES_BOOTSTRAP_PASSWORD=your_supabase_database_password
POSTGRES_BOOTSTRAP_SSL_MODE=require

# Migration connection — use the shared Session pooler on IPv4, or the direct
# endpoint when IPv6 is available. Never use transaction mode for migrations.
# These variables are never required by the running API.
POSTGRES_MIGRATION_HOST=aws-0-ap-southeast-2.pooler.supabase.com
POSTGRES_MIGRATION_PORT=5432
POSTGRES_MIGRATION_SSL_MODE=require
POSTGRES_MIGRATION_USER=research_tracker_migration.your-project-ref
POSTGRES_MIGRATION_PASSWORD=your_migration_password

# Runtime role — DML-only privileges. Used by the running NestJS application.
POSTGRES_RUNTIME_USER=research_tracker_app.your-project-ref
POSTGRES_RUNTIME_PASSWORD=your_runtime_password

# Local Docker only. Do not use these values for Supabase or Lambda.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_development_password

# Supabase Auth. The API verifies access tokens through the project's public
# JWKS endpoint; no Supabase secret key is required for normal API requests.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Frontend origin — used for CORS and invitation links.
APP_URL=http://localhost:5173

# Invitation links expire after 72 hours by default. Tokens must contain at
# least 32 random bytes.
INVITATION_TOKEN_TTL_HOURS=72
INVITATION_TOKEN_BYTES=32

# Amazon SES invitation delivery. The sender identity must be verified in SES.
INVITATION_EMAIL_FROM=verified-sender@example.com
# AWS SES region.
INVITATION_EMAIL_REGION=ap-southeast-2
AWS_REGION=ap-southeast-2

# Local development only when credentials are stored under a named AWS profile.
# Omit this in AWS deployments that use an IAM role.
AWS_PROFILE=research-dev

NODE_ENV=development

# Feedback notification recipient.
# TODO(team): confirm the monitored recipient inbox before pilot rollout.
# Feedback is still stored when this is empty; email notification is skipped.
FEEDBACK_EMAIL_TO=
