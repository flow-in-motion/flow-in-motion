# PostgreSQL connection
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=your_postgres_port
POSTGRES_DB=your_db_name
POSTGRES_SSL=false

# Bootstrap superuser — used only once, to create the migration and runtime roles below.
# Never used by the running application or by migrations directly.
POSTGRES_USER=your_postgres_superuser
POSTGRES_PASSWORD=your_postgres_superuser_password

# Migration role — full DDL privileges. Used only when running migrations
# (locally by a developer, or by CI/CD during deployment).
POSTGRES_MIGRATION_USER=your_migration_user
POSTGRES_MIGRATION_PASSWORD=your_migration_password

# Runtime role — DML-only privileges. Used by the running NestJS application.
POSTGRES_RUNTIME_USER=your_runtime_user
POSTGRES_RUNTIME_PASSWORD=your_runtime_password

# MinIO
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ENDPOINT=http://your_minio_host:9000

# Cognito
# These are unique to your own AWS deployment — get them by running
# `tofu output` from infrastructure/opentofu/environments/dev after applying.
COGNITO_REGION=your_aws_region
COGNITO_USER_POOL_ID=your_cognito_user_pool_id
COGNITO_CLIENT_ID=your_cognito_app_client_id
COGNITO_DOMAIN=your_cognito_domain

# Frontend origin — used for CORS and invitation links.
APP_URL=http://localhost:5173

# Invitation links expire after 72 hours by default. Tokens must contain at
# least 16 random bytes; 32 bytes is recommended.
INVITATION_TOKEN_TTL_HOURS=72
INVITATION_TOKEN_BYTES=32

# Amazon SES invitation delivery. The sender identity must be verified in SES.
INVITATION_EMAIL_FROM=verified-sender@example.com
# Optional; defaults to COGNITO_REGION.
INVITATION_EMAIL_REGION=ap-southeast-2

# Local development only when credentials are stored under a named AWS profile.
# Omit this in AWS deployments that use an IAM role.
AWS_PROFILE=research-dev

NODE_ENV=development

# Feedback notification recipient.
# TODO(team): confirm the monitored recipient inbox before pilot rollout.
# Feedback is still stored when this is empty; email notification is skipped.
FEEDBACK_EMAIL_TO=
